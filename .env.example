# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=banking
DB_PASSWORD=banking
DB_NAME=banking_soap
# En developpement uniquement : cree/aligne le schema au demarrage.
# En production, laisser a false et utiliser les migrations TypeORM.
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# ---------------------------------------------------------------------------
# Service SOAP (DataAccess - Number Conversion)
# ---------------------------------------------------------------------------
SOAP_ENDPOINT=https://www.dataaccess.com/webservicesserver/NumberConversion.wso
# local  -> charge le WSDL embarque dans src/soap/wsdl (aucun appel reseau au boot)
# remote -> telecharge le WSDL depuis SOAP_WSDL_URL au demarrage du client
SOAP_WSDL_SOURCE=local
SOAP_WSDL_URL=https://www.dataaccess.com/webservicesserver/NumberConversion.wso?WSDL
SOAP_TIMEOUT_MS=8000
SOAP_MAX_RETRIES=2
SOAP_RETRY_DELAY_MS=300
# Taille max (octets) d'une reponse XML acceptee par le parseur
SOAP_MAX_RESPONSE_BYTES=1048576

# ---------------------------------------------------------------------------
# Metier
# ---------------------------------------------------------------------------
# Devises acceptees (ISO 4217), separees par des virgules
ALLOWED_CURRENCIES=EUR,USD,GBP,CHF,XOF,XAF,CDF
TRANSFER_MAX_AMOUNT=999999999.99

# Compte bancaire technique utilise comme source du flux Mobile Money
MOBILE_MONEY_SETTLEMENT_IBAN=FR7630006000011234567890189
MOBILE_MONEY_SETTLEMENT_NAME=Mobile Money Settlement
# A remplacer par un secret aleatoire hors environnement local
MOBILE_MONEY_WEBHOOK_SECRET=local-demo-webhook-secret
# Le simulateur doit rester desactive sur une API exposee
MOBILE_MONEY_SIMULATOR_ENABLED=true
# Drainage asynchrone des instructions bancaires confirmees
MOBILE_MONEY_BANK_WORKER_ENABLED=true
MOBILE_MONEY_BANK_WORKER_INTERVAL_MS=2000
MOBILE_MONEY_BANK_WORKER_MAX_ATTEMPTS=4

# ---------------------------------------------------------------------------
# Journalisation / audit
# ---------------------------------------------------------------------------
LOG_LEVEL=log
# Taille max d'un payload XML conserve en base d'audit (caracteres)
AUDIT_MAX_PAYLOAD_CHARS=8000
# false -> les payloads XML ne sont pas persistes du tout (mode strict)
AUDIT_PERSIST_PAYLOADS=true

# ---------------------------------------------------------------------------
# Garde des secrets et chiffrement au repos
# ---------------------------------------------------------------------------
# Generer une valeur dediee : openssl rand -base64 32
# La valeur de demonstration est refusee en production.
SECURITY_MASTER_KEY=REMPLACER_PAR_OPENSSL_RAND_BASE64_32
# Identifiant non secret inclus dans chaque chiffre : changer avec la cle.
SECURITY_CURRENT_KEY_ID=local-v1
# Anciennes cles en lecture seule : keyId|Base64,keyId|Base64
SECURITY_PREVIOUS_KEYS=
# Uniquement pendant la migration depuis l'ancien format enc.v1.<payload> :
# ancienne valeur brute de SECURITY_MASTER_KEY, a retirer apres migration.
SECURITY_LEGACY_MASTER_KEY=
# Sel HKDF non secret, stable entre les redemarrages.
SECURITY_KEY_SALT=banking-gateway-hkdf-salt

# ---------------------------------------------------------------------------
# Blockchain — registre d'audit (nœud EVM local)
# ---------------------------------------------------------------------------
# false -> les transactions sont scellees (empreinte calculee) mais jamais ancrees
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Prefixe optionnel vers une transaction sur l'explorateur du reseau
BLOCKCHAIN_EXPLORER_TX_URL=
# Adresse obtenue via : npm run contract:deploy
BLOCKCHAIN_CONTRACT_ADDRESS=
# Compte #0 d'Anvil / du noeud Hardhat : publique, sans valeur hors chaine locale.
# En production, cette cle viendrait d'un HSM ou d'un KMS, jamais d'un fichier .env.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_CONFIRMATIONS=1

# ---------------------------------------------------------------------------
# Ancrage par lots (arbre de Merkle)
# ---------------------------------------------------------------------------
ANCHOR_BATCH_MAX_SIZE=50
ANCHOR_INTERVAL_MS=15000
ANCHOR_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Authentification (cles d'API)
# ---------------------------------------------------------------------------
# false ouvre l'API en grand, remboursements compris. Refuse en production par
# la validation d'environnement.
AUTH_ENABLED=true
# Entrees separees par « ; » au format : keyId|sha256Hex|scope1,scope2|libelle
# Seules des empreintes y figurent — jamais un secret exploitable.
# Generer une cle :  node scripts/generate-api-key.js <keyId> <scopes> [libelle]
# Habilitations : transfers:read  transfers:write  refunds:write  refunds:approve
#                 reconciliation:write  anchors:read  anchors:write
#                 simulator:write
API_KEYS=
