<?xml version="1.0" encoding="UTF-8"?>
<!--
  Enregistrement scelle d'une transaction : le document dont l'empreinte est
  ancree sur la blockchain.

  Il differe de transfer-request.xsd sur un point essentiel : il decrit l'etat
  FINAL et immuable de la transaction (resultat de l'appel SOAP compris), et non
  la demande initiale. Il n'est produit qu'une fois la transaction dans un etat
  terminal — c'est ce qui permet de le sceller une seule fois, definitivement.

  Ce document contient les IBAN complets : c'est indispensable, puisque l'objet
  de la preuve est justement de rendre detectable la modification d'un
  beneficiaire. Il n'est jamais publie ni transmis — seule son empreinte salee
  (keccak256) quitte le systeme, et l'on ne peut rien en reconstituer.

  L'ordre des elements est impose par xs:sequence : c'est ce qui garantit la
  canonicite. Deux serialisations de la meme transaction produisent forcement le
  meme octet, donc la meme empreinte.
-->
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:banking:transfer:1.0"
    targetNamespace="urn:banking:transfer:1.0"
    elementFormDefault="qualified"
    version="1.0">

  <xs:simpleType name="TransactionReferenceType">
    <xs:restriction base="xs:string">
      <xs:pattern value="TRF-[0-9]{8}-[0-9A-HJ-NP-Z]{8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IbanType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}"/>
      <xs:maxLength value="34"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CurrencyType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AmountType">
    <xs:annotation>
      <xs:documentation>
        Toujours serialise avec exactement 2 decimales (1250.7 -> "1250.70") :
        sans cette contrainte, deux ecritures du meme montant produiraient deux
        empreintes differentes.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,16}\.[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TerminalStatusType">
    <xs:annotation>
      <xs:documentation>
        Seuls les etats terminaux sont scellables : une transaction encore en
        cours de traitement changerait d'empreinte.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="COMPLETED"/>
      <xs:enumeration value="FAILED"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===================================================================== -->

  <xs:complexType name="PartyType">
    <xs:sequence>
      <xs:element name="iban" type="tns:IbanType"/>
      <xs:element name="name" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SoapExchangeType">
    <xs:annotation>
      <xs:documentation>
        Resultat de l'echange avec le back-office. Scelle au meme titre que les
        donnees de paiement : le motif d'un rejet fait partie de la piste d'audit.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="operation" type="xs:string" minOccurs="0"/>
      <xs:element name="durationMs" type="xs:nonNegativeInteger" minOccurs="0"/>
      <xs:element name="attempts" type="xs:positiveInteger" minOccurs="0"/>
      <xs:element name="amountInWords" type="xs:string" minOccurs="0"/>
      <xs:element name="faultCode" type="xs:string" minOccurs="0"/>
      <xs:element name="faultString" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TransferRecordType">
    <xs:sequence>
      <xs:element name="reference" type="tns:TransactionReferenceType"/>
      <xs:element name="status" type="tns:TerminalStatusType"/>
      <xs:element name="debtor" type="tns:PartyType"/>
      <xs:element name="creditor" type="tns:PartyType"/>
      <xs:element name="amount" type="tns:AmountType"/>
      <xs:element name="currency" type="tns:CurrencyType"/>
      <xs:element name="endToEndLabel" type="xs:string" minOccurs="0"/>
      <xs:element name="soap" type="tns:SoapExchangeType"/>
      <xs:element name="correlationId" type="xs:string"/>
      <xs:element name="createdAt" type="xs:dateTime"/>
      <xs:element name="processedAt" type="xs:dateTime"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          Version du format de scellement. Toute evolution de la structure
          changerait les empreintes : la version permet de rejouer la
          verification d'archives anciennes avec le bon serialiseur.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:element name="TransferRecord" type="tns:TransferRecordType"/>

</xs:schema>
