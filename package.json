{
  "name": "banking-blockchain-audit-gateway",
  "version": "1.0.0",
  "description": "Passerelle bancaire : API REST -> XML canonique valide par XSD -> service SOAP -> PostgreSQL -> preuve d'integrite ancree sur blockchain (Merkle)",
  "author": "nazaawa <johnnyetsha@gmail.com>",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "auth:keygen": "node scripts/generate-api-key.js",
    "contract:compile": "node scripts/compile-contract.js",
    "contract:deploy": "node scripts/deploy-contract.js",
    "chain:node": "hardhat node --port 8545",
    "ops:verify-restore": "ts-node -r tsconfig-paths/register scripts/verify-restore.ts",
    "verify": "npm run lint -- --max-warnings=0 && npx tsc --noEmit -p tsconfig.json && npm run build && npx prettier --check \"src/**/*.ts\" \"test/**/*.ts\" README.md && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ethers": "^6.17.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "soap": "^1.1.5",
    "typeorm": "^0.3.20",
    "xml2js": "^0.6.2",
    "xmllint-wasm": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/xml2js": "^0.4.14",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "hardhat": "^2.29.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "solc": "^0.8.36",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coveragePathIgnorePatterns": [
      "\\.module\\.ts$",
      "main\\.ts$",
      "\\.entity\\.ts$",
      "\\.dto\\.ts$",
      "data-source\\.ts$"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
